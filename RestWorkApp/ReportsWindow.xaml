<Window x:Class="RestaurantWorkApp.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        mc:Ignorable="d" 
        Title="Отчёты"
        Height="700" Width="1100"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundColor}"
        ResizeMode="CanResize"
        FontFamily="{StaticResource MainFont}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 🔷 Панель фильтров -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,20">
            <Grid>
                <!-- 3 колонки по 180px под фильтры + авто-колонка под кнопку -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Тип отчёта -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <Label Content="ТИП ОТЧЁТА" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="cmbReportType" HorizontalAlignment="Stretch" SelectionChanged="cmbReportType_SelectionChanged">
                        <ComboBoxItem Content="Прибыль за период" IsSelected="True"/>
                        <ComboBoxItem Content="Популярные блюда"/>
                        <ComboBoxItem Content="Печать чека"/>
                    </ComboBox>
                </StackPanel>

                <!-- Период -->
                <StackPanel Grid.Column="1" Margin="0,0,12,0" x:Name="panelPeriod">
                    <Label Content="ПЕРИОД" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="cmbPeriod" HorizontalAlignment="Stretch" SelectionChanged="cmbPeriod_SelectionChanged">
                        <ComboBoxItem Content="Текущий месяц"/>
                        <ComboBoxItem Content="Текущий квартал"/>
                        <ComboBoxItem Content="Текущий год"/>
                        <ComboBoxItem Content="За всё время"/>
                        <ComboBoxItem Content="Свой период"/>
                    </ComboBox>
                </StackPanel>

                <!-- Даты (свой период) -->
                <StackPanel Grid.Column="2" Margin="0,0,12,0" x:Name="panelDates" Visibility="Collapsed">
                    <Label Content="ДАТЫ" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- 84 + 12(стрелка) + 84 = ровно 180px, как у комбобоксов выше -->
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="84"/>
                        </Grid.ColumnDefinitions>
                        <DatePicker x:Name="dpFrom" Grid.Column="0" Width="84"/>
                        <Label Content="→" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource GrayColor}" Margin="6,0,6,0" Padding="0"/>
                        <DatePicker x:Name="dpTo" Grid.Column="2" Width="84"/>
                    </Grid>
                </StackPanel>

                <!-- Выбор чека (для печати) -->
                <StackPanel Grid.Column="2" Margin="0,0,12,0" x:Name="panelCheck" Visibility="Collapsed">
                    <Label Content="ВЫБЕРИТЕ ЗАКАЗ" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="cmbCheck" HorizontalAlignment="Stretch" DisplayMemberPath="DisplayText" SelectedValuePath="id_Zakaz"/>
                </StackPanel>

                <!-- Кнопка формирования -->
                <StackPanel Grid.Column="3" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                    <Button x:Name="btnGenerate" Style="{StaticResource PrimaryButtonStyle}"
                            Content="Сформировать" Height="40" Width="150"
                            FontWeight="Normal"
                            Click="btnGenerate_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 🔷 Таблица с данными -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,20">
            <DataGrid x:Name="dgPreview" 
                      Style="{StaticResource BootstrapDataGridStyle}"
                      AutoGenerateColumns="True" 
                      CanUserResizeColumns="True" 
                      IsReadOnly="True"
                      HeadersVisibility="Column" 
                      BorderThickness="0"/>
        </Border>

        <!-- 🔷 Кнопки экспорта -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnExportExcel" Style="{StaticResource SecondaryButtonStyle}"
                    Content="Экспорт в Excel" Height="42" Width="160" Margin="0,0,12,0"
                    Click="btnExportExcel_Click" Visibility="Collapsed"/>
            <Button x:Name="btnPrintPdf" Style="{StaticResource DangerButtonStyle}"
                    Content="Печать PDF" Height="42" Width="140"
                    Click="btnPrintPdf_Click" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>