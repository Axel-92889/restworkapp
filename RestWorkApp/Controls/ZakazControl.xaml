<UserControl x:Class="RestaurantWorkApp.Controls.ZakazControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1000"
             Background="#F5F5F5"
             FontFamily="{StaticResource MainFont}">

    <Grid Margin="0,0,0,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 🔷 Форма добавления -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <StackPanel>
                <Border Style="{StaticResource CardHeaderStyle}">
                    <TextBlock Text="Управление заказами" Style="{StaticResource PageTitleStyle}" Margin="0"/>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0 -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,20,0">
                        <Label Style="{StaticResource FormLabelStyle}" Content="Дата и время заказа *"/>
                        <TextBox x:Name="txtDataZ" Style="{StaticResource ModernTextBoxStyle}" Height="44"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,20,0">
                        <Label Style="{StaticResource FormLabelStyle}" Content="Статус (N/P/C) *"/>
                        <TextBox x:Name="txtStatusZ" Style="{StaticResource ModernTextBoxStyle}" Text="N" Height="44"/>
                    </StackPanel>

                    <!-- Row 1 -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,20,0">
                        <Label Style="{StaticResource FormLabelStyle}" Content="Время начала"/>
                        <TextBox x:Name="txtStartTime" Style="{StaticResource ModernTextBoxStyle}" Height="44"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,20,0">
                        <Label Style="{StaticResource FormLabelStyle}" Content="Время окончания"/>
                        <TextBox x:Name="txtEndTime" Style="{StaticResource ModernTextBoxStyle}" Height="44"/>
                    </StackPanel>

                    <!-- Row 2 -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,20,0">
                        <Label Style="{StaticResource FormLabelStyle}" Content="ID Клиента *"/>
                        <TextBox x:Name="txtClientId" Style="{StaticResource ModernTextBoxStyle}" Height="44"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,20,0">
                        <Label Style="{StaticResource FormLabelStyle}" Content="ID Сотрудника *"/>
                        <TextBox x:Name="txtRabotnikId" Style="{StaticResource ModernTextBoxStyle}" Height="44"/>
                    </StackPanel>

                    <!-- Row 3 -->
                    <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,20,0">
                        <Label Style="{StaticResource FormLabelStyle}" Content="ID Акции"/>
                        <TextBox x:Name="txtPromoId" Style="{StaticResource ModernTextBoxStyle}" Height="44"/>
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,20,0">
                        <Label Style="{StaticResource FormLabelStyle}" Content="Сумма заказа"/>
                        <TextBox x:Name="txtPriceZ" Style="{StaticResource ModernTextBoxStyle}" Text="0.00" Height="44"/>
                    </StackPanel>
                </Grid>

                <StackPanel HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button x:Name="btnAdd" Style="{StaticResource PrimaryButtonStyle}"
                            Content="Добавить" Height="44" Width="200"
                            Click="btnAdd_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 🔷 Таблица -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Список заказов" FontSize="16" FontWeight="SemiBold" Foreground="#2D3436" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="btnRefresh" Style="{StaticResource SecondaryButtonStyle}"
                                Content="Обновить" Height="38" Width="110" Margin="0,0,10,0" Click="btnRefresh_Click"/>
                        <Button x:Name="btnDelete" Style="{StaticResource DangerButtonStyle}"
                                Content="Удалить" Height="38" Width="110" Click="btnDelete_Click"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#DFE6E9" BorderThickness="1" Margin="0,0,0,15">
                    <DataGrid x:Name="dgZakaz" Style="{StaticResource BootstrapDataGridStyle}"
                              AutoGenerateColumns="False" CellEditEnding="dgZakaz_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Width="60" Binding="{Binding id_Zakaz}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Дата заказа" Width="120" Binding="{Binding Data_Z}"/>
                            <DataGridTextColumn Header="Начало" Width="100" Binding="{Binding Start_Time}"/>
                            <DataGridTextColumn Header="Окончание" Width="100" Binding="{Binding End_Time}"/>
                            <DataGridTextColumn Header="Статус" Width="70" Binding="{Binding Status_Z}"/>
                            <DataGridTextColumn Header="Клиент" Width="70" Binding="{Binding id_client}"/>
                            <DataGridTextColumn Header="Сотрудник" Width="90" Binding="{Binding id_rabotnik}"/>
                            <DataGridTextColumn Header="Акция" Width="70" Binding="{Binding id_promotion}"/>
                            <DataGridTextColumn Header="Сумма" Width="90" Binding="{Binding Price_Z, StringFormat={}{0:F2} ₽}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>