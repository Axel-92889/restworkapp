<UserControl x:Class="RestaurantWorkApp.Controls.CategoryControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="#F5F5F5"
             FontFamily="{StaticResource MainFont}">

    <Grid Margin="0,0,0,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 🔷 Заголовок + Форма добавления -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <StackPanel>
                <Border Style="{StaticResource CardHeaderStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Справочник — Категории" Style="{StaticResource PageTitleStyle}" Margin="0"/>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <Label Style="{StaticResource FormLabelStyle}" Content="Название категории"/>
                        <TextBox x:Name="txtCategoryName" Style="{StaticResource ModernTextBoxStyle}" 
                                 VerticalContentAlignment="Center" Height="44" TextChanged="txtCategoryName_TextChanged"/>
                        <TextBlock Text="От 2 до 50 символов, уникальное значение"
                                   Foreground="#636E72" FontSize="11" Margin="0,6,0,0" FontStyle="Italic"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                        <Button x:Name="btnAdd" Style="{StaticResource PrimaryButtonStyle}"
                                Content="Добавить" Height="44" Width="180"
                                Margin="0,0,0,20" Click="btnAdd_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 🔷 Таблица категорий -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Панель управления -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Список категорий" FontSize="16" FontWeight="SemiBold" 
                               Foreground="#2D3436" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="btnRefresh" Style="{StaticResource SecondaryButtonStyle}"
                                Content="Обновить" Height="38" Width="110" Margin="0,0,10,0"
                                Click="btnRefresh_Click"/>
                        <Button x:Name="btnDelete" Style="{StaticResource DangerButtonStyle}"
                                Content="Удалить" Height="38" Width="110"
                                Click="btnDelete_Click"/>
                    </StackPanel>
                </Grid>

                <!-- DataGrid -->
                <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#DFE6E9" BorderThickness="1" Margin="0,0,0,15">
                    <DataGrid x:Name="dgCategories"
                              Style="{StaticResource BootstrapDataGridStyle}"
                              AutoGenerateColumns="False"
                              CellEditEnding="dgCategories_CellEditEnding"
                              CanUserResizeColumns="True"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Width="80" Binding="{Binding id_Category}" IsReadOnly="True" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="Название" Width="*" Binding="{Binding Name_C}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Подсказка -->
                <TextBlock Grid.Row="2" Text="💡 Нажмите на ячейку названия для редактирования"
                           Foreground="#636E72" FontSize="12" FontStyle="Italic" HorizontalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>