<UserControl x:Class="RestaurantWorkApp.Controls.DishControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="#F5F5F5"
             FontFamily="{StaticResource MainFont}">

    <Grid Margin="0,0,0,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 🔷 Форма добавления -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <StackPanel>
                <Border Style="{StaticResource CardHeaderStyle}">
                    <TextBlock Text="Управление блюдами" Style="{StaticResource PageTitleStyle}" Margin="0"/>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,20,0">
                        <Label Style="{StaticResource FormLabelStyle}" Content="Название блюда *"/>
                        <TextBox x:Name="txtNameDish" Style="{StaticResource ModernTextBoxStyle}" Height="44"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,20,0">
                        <Label Style="{StaticResource FormLabelStyle}" Content="Цена *"/>
                        <TextBox x:Name="txtPrice" Style="{StaticResource ModernTextBoxStyle}" Height="44"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,20,0">
                        <Label Style="{StaticResource FormLabelStyle}" Content="Статус (A/D)"/>
                        <TextBox x:Name="txtStatus" Style="{StaticResource ModernTextBoxStyle}" Text="A" Height="44"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,20,0">
                        <Label Style="{StaticResource FormLabelStyle}" Content="URL изображения"/>
                        <TextBox x:Name="txtImageURL" Style="{StaticResource ModernTextBoxStyle}" Height="44"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,20,0">
                        <Label Style="{StaticResource FormLabelStyle}" Content="ID категории *"/>
                        <TextBox x:Name="txtCategoryId" Style="{StaticResource ModernTextBoxStyle}" Height="44"/>
                    </StackPanel>
                </Grid>

                <StackPanel HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button x:Name="btnAdd" Style="{StaticResource PrimaryButtonStyle}"
                            Content="Добавить" Height="44" Width="180"
                            Click="btnAdd_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 🔷 Таблица -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Список блюд" FontSize="16" FontWeight="SemiBold" Foreground="#2D3436" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="btnRefresh" Style="{StaticResource SecondaryButtonStyle}"
                                Content="Обновить" Height="38" Width="110" Margin="0,0,10,0" Click="btnRefresh_Click"/>
                        <Button x:Name="btnDelete" Style="{StaticResource DangerButtonStyle}"
                                Content="Удалить" Height="38" Width="110" Click="btnDelete_Click"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#DFE6E9" BorderThickness="1" Margin="0,0,0,15">
                    <DataGrid x:Name="dgDishes" Style="{StaticResource BootstrapDataGridStyle}"
                              AutoGenerateColumns="False" CellEditEnding="dgDishes_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Width="70" Binding="{Binding id_Dish}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Название" Width="2*" Binding="{Binding Name_Dish}"/>
                            <DataGridTextColumn Header="Цена" Width="*" Binding="{Binding Price_D, StringFormat={}{0:F2} ₽}"/>
                            <DataGridTextColumn Header="Статус" Width="80" Binding="{Binding Status_D}"/>
                            <DataGridTextColumn Header="Изображение" Width="2*" Binding="{Binding Image_URL}"/>
                            <DataGridTextColumn Header="ID категории" Width="*" Binding="{Binding id_category}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>