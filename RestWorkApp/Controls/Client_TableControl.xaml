<UserControl x:Class="RestaurantWorkApp.Controls.Client_TableControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             Background="#F5F5F5"
             FontFamily="{StaticResource MainFont}">

    <UserControl.Resources>
        <x:Array x:Key="StatusOptions" Type="sys:String">
            <sys:String>A</sys:String>
            <sys:String>F</sys:String>
            <sys:String>R</sys:String>
            <sys:String>B</sys:String>
        </x:Array>
    </UserControl.Resources>

    <Grid Margin="0,0,0,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 🔷 Форма добавления -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <StackPanel>
                <Border Style="{StaticResource CardHeaderStyle}">
                    <TextBlock Text="Управление столами" Style="{StaticResource PageTitleStyle}" Margin="0"/>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <Label Style="{StaticResource FormLabelStyle}" Content="Номер стола"/>
                        <TextBox x:Name="txtNumber_T" Style="{StaticResource ModernTextBoxStyle}" Height="44"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,20,0">
                        <Label Style="{StaticResource FormLabelStyle}" Content="Кол-во мест"/>
                        <TextBox x:Name="txtSeats" Style="{StaticResource ModernTextBoxStyle}" Height="44"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,20,0">
                        <Label Style="{StaticResource FormLabelStyle}" Content="Статус"/>
                        <ComboBox x:Name="cbStatus_T" ItemsSource="{StaticResource StatusOptions}" SelectedIndex="1" Height="44"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,20,0">
                        <Label Style="{StaticResource FormLabelStyle}" Content="ID зоны"/>
                        <TextBox x:Name="txtIdZone" Style="{StaticResource ModernTextBoxStyle}" Height="44"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                        <Button x:Name="btnAdd" Style="{StaticResource PrimaryButtonStyle}"
                                Content="Добавить" Height="44" Width="180"
                                Margin="0,0,0,20" Click="btnAdd_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 🔷 Таблица столов -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Список столов" FontSize="16" FontWeight="SemiBold" Foreground="#2D3436" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="btnRefresh" Style="{StaticResource SecondaryButtonStyle}"
                                Content="Обновить" Height="38" Width="110" Margin="0,0,10,0" Click="btnRefresh_Click"/>
                        <Button x:Name="btnDelete" Style="{StaticResource DangerButtonStyle}"
                                Content="Удалить" Height="38" Width="110" Click="btnDelete_Click"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#DFE6E9" BorderThickness="1" Margin="0,0,0,15">
                    <DataGrid x:Name="dgTables" Style="{StaticResource BootstrapDataGridStyle}"
                              AutoGenerateColumns="False" CellEditEnding="dgTables_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Width="80" Binding="{Binding id_Table}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Номер" Width="*" Binding="{Binding Number_T}"/>
                            <DataGridTextColumn Header="Места" Width="*" Binding="{Binding Seats}"/>
                            <DataGridComboBoxColumn Header="Статус" Width="*"
                                                    ItemsSource="{Binding Source={StaticResource StatusOptions}}"
                                                    SelectedItemBinding="{Binding Status_T}"/>
                            <DataGridTextColumn Header="ID зоны" Width="*" Binding="{Binding id_zone}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>