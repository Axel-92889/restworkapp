<Window x:Class="RestaurantWorkApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Панель управления рестораном - Пицца от Куницы"
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        ResizeMode="CanResize"
        WindowState="Maximized"
        FontFamily="{StaticResource MainFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        >

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 🔷 Левая панель (Sidebar) -->
        <Border Grid.Column="0" Background="White" 
                BorderBrush="#FF6B6B" BorderThickness="0,0,2,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Логотип -->
                <Border Grid.Row="0" Padding="20,15" BorderThickness="0,0,0,1" 
                        BorderBrush="#FFE8E8E8">
                    <StackPanel>
                        <TextBlock Text="🍕 Пицца от Куницы"
                                  Foreground="#FF6B6B"
                                  FontSize="16"
                                  FontWeight="Bold"/>
                        <TextBlock Text="Панель управления"
                                  Foreground="#636E72"
                                  FontSize="11"
                                  Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Меню навигации -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,10,10,0">

                        <!-- Главная -->
                        <Button x:Name="btnHome"
                                Content="На главную"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="42"
                                Margin="0,0,0,4"
                                Click="btnHome_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" 
                                            Background="Transparent"
                                            CornerRadius="8"
                                            Padding="12,0">
                                        <ContentPresenter HorizontalAlignment="Left" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#FFF5F5F5"/>
                                            <Setter TargetName="border" Property="TextElement.Foreground" Value="#FF6B6B"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#FFE8F4FD"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Разделитель -->
                        <Rectangle Height="1" Fill="#DFE6E9" Margin="10,15"/>

                        <!-- Заголовок: Управление рестораном -->
                        <TextBlock Text="УПРАВЛЕНИЕ"
                                  Foreground="#636E72"
                                  FontSize="10"
                                  FontWeight="Bold"
                                  Margin="22,10,0,8"
                                  Opacity="0.7"/>

                        <!-- Справочники -->
                        <Button x:Name="btnDirectories"
                                Content="▼ Справочники"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="42"
                                Margin="0,0,0,4"
                                Click="btnDirectories_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" 
                                            Background="Transparent"
                                            CornerRadius="8"
                                            Padding="12,0">
                                        <ContentPresenter HorizontalAlignment="Left" 
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#FFF5F5F5"/>
                                            <Setter TargetName="border" Property="TextElement.Foreground" Value="#FF6B6B"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- ▼ Выпадающая панель справочников -->
                        <Border x:Name="directoriesPanel"
                                Background="#FFF9F9F9"
                                CornerRadius="8"
                                Margin="15,2,15,8"
                                BorderBrush="#FFE8E8E8"
                                BorderThickness="1"
                                Visibility="Collapsed"
                                Padding="8,5">
                            <ScrollViewer VerticalScrollBarVisibility="Hidden" MaxHeight="380">
                                <StackPanel>
                                    <Button Content="Роли пользователей" Style="{StaticResource SubMenuItemStyle}" Click="btnRulesDir_Click"/>
                                    <Button Content="Должности" Style="{StaticResource SubMenuItemStyle}" Click="btnDolhDir_Click"/>
                                    <Button Content="Категории" Style="{StaticResource SubMenuItemStyle}" Click="btnCategoryDir_Click"/>
                                    <Button Content="Ингредиенты" Style="{StaticResource SubMenuItemStyle}" Click="btnIngredientsDir_Click"/>
                                    <Button Content="Блюда" Style="{StaticResource SubMenuItemStyle}" Click="btnDishDir_Click"/>
                                    <Button Content="Состав блюд" Style="{StaticResource SubMenuItemStyle}" Click="btnDishIngredientsDir_Click"/>
                                    <Button Content="Акции" Style="{StaticResource SubMenuItemStyle}" Click="btnPromotionsDir_Click"/>
                                    <Button Content="Клиенты" Style="{StaticResource SubMenuItemStyle}" Click="btnClientDir_Click"/>
                                    <Button Content="Работники" Style="{StaticResource SubMenuItemStyle}" Click="btnRabotnikDir_Click"/>
                                    <Button Content="Столы" Style="{StaticResource SubMenuItemStyle}" Click="btnTableDir_Click"/>
                                    <Button Content="Зоны" Style="{StaticResource SubMenuItemStyle}" Click="btnZoneDir_Click"/>
                                    <Button Content="Заказы" Style="{StaticResource SubMenuItemStyle}" Click="btnZakazDir_Click"/>
                                    <Button Content="Элементы заказов" Style="{StaticResource SubMenuItemStyle}" Click="btnZakazItemsDir_Click"/>
                                    <Button Content="Чеки" Style="{StaticResource SubMenuItemStyle}" Click="btnCheckDir_Click"/>
                                    <Button Content="Доставка" Style="{StaticResource SubMenuItemStyle}" Click="btnDeliveryDir_Click"/>
                                    <Button Content="Бронирования" Style="{StaticResource SubMenuItemStyle}" Click="btnReservDir_Click"/>
                                    <Button Content="Отзывы" Style="{StaticResource SubMenuItemStyle}" Click="btnFeedbackDir_Click"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Заказы 
                        <Button x:Name="btnOrders"
                                Content="📦 Заказы"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="42"
                                Margin="0,0,0,4"
                                Click="btnOrders_Click"/>
                        -->
                        <!-- Бронирование 
                        <Button x:Name="btnReservations"
                                Content="📅 Бронирование"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Height="42"
                                Margin="0,0,0,4"
                                Click="btnReservations_Click"/>
                        -->
                        <!-- Отчёты -->
                        <Button x:Name="btnReports"
        Content="Отчёты"
        Style="{StaticResource SecondaryButtonStyle}"
        Height="42"
        Margin="0,0,0,4"
        Click="btnReports_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" 
                    Background="Transparent"
                    CornerRadius="8"
                    Padding="12,0">
                                        <ContentPresenter HorizontalAlignment="Left" 
                                  VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#FFF5F5F5"/>
                                            <Setter TargetName="border" Property="TextElement.Foreground" Value="#FF6B6B"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#FFE8F4FD"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

                <!-- 🔗 Кнопка-ссылка на Word-файл (перемещена выше) -->
                <Border Grid.Row="2" Padding="15,10,15,5" Background="Transparent">
                    <Button x:Name="btnWordLink"
                        Content="Руководство пользователя"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="40"
                        FontSize="13"
                        Click="btnWordLink_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" 
                                    Background="Transparent"
                                    CornerRadius="8"
                                    Padding="12,0">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                        VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#FFF5F5F5"/>
                                        <Setter TargetName="border" Property="TextElement.Foreground" Value="#FF6B6B"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#FFE8F4FD"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>

                <!-- 🌓 Переключатель темы -->
                <Border Grid.Row="3" Padding="15,10,15,15" BorderThickness="0,1,0,0" BorderBrush="#FFE8E8E8">
                    <StackPanel>
                        <TextBlock Text="Тема оформления"
                                  Foreground="#636E72"
                                  FontSize="11"
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,8"
                                  HorizontalAlignment="Center"/>
                        
                        <Border x:Name="ThemeToggle"
                                Width="200"
                                Height="40"
                                CornerRadius="20"
                                Background="#DFE6E9"
                                Cursor="Hand"
                                MouseLeftButtonDown="ThemeToggle_MouseLeftButtonDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Иконка луны (слева) -->
                                <Viewbox Grid.Column="0" Width="20" Height="20" Margin="10,0,0,0" HorizontalAlignment="Left">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#636E72" Data="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-3.03 0-5.5-2.47-5.5-5.5 0-1.82.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z"/>
                                    </Canvas>
                                </Viewbox>
                                
                                <!-- Иконка солнца (справа) -->
                                <Viewbox Grid.Column="1" Width="20" Height="20" Margin="0,0,10,0" HorizontalAlignment="Right">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#FDCB6E" Data="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58c-.39-.39-1.03-.39-1.41 0-.39.39-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37c-.39-.39-1.03-.39-1.41 0-.39.39-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0 .39-.39.39-1.03 0-1.41l-1.06-1.06zm1.06-10.96c.39-.39.39-1.03 0-1.41-.39-.39-1.03-.39-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06zM7.05 18.36c.39-.39.39-1.03 0-1.41-.39-.39-1.03-.39-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06z"/>
                                    </Canvas>
                                </Viewbox>
                                
                                <!-- Кружок переключателя -->
                                <Border x:Name="ToggleCircle"
                                        Width="32"
                                        Height="32"
                                        CornerRadius="16"
                                        Background="White"
                                        HorizontalAlignment="Left"
                                        Margin="4,0,0,0"
                                        Effect="{StaticResource CardShadow}">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Border.MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ToggleCircle" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="100" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="ThemeToggle" Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)" To="#FFE0E0E0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="Border.MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ToggleCircle" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="ThemeToggle" Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)" To="#FFDFE6E9" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 👤 Профиль + Выход -->
                <Border Grid.Row="4" Padding="15" BorderThickness="0,1,0,0" BorderBrush="#FFE8E8E8">
                    <StackPanel>
                        <Button x:Name="btnLogout"
                                Content="Выйти из системы"
                                Style="{StaticResource DangerButtonStyle}"
                                Height="40"
                                FontSize="13"
                                Click="btnLogout_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 🔷 Правая панель (Основной контент) -->
        <Grid Grid.Column="1" Background="#F5F5F5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок страницы с информацией о пользователе -->
            <Border Grid.Row="0" Background="White" 
                    Padding="25,20" 
                    BorderThickness="0,0,0,1" 
                    BorderBrush="#FFE8E8E8">
                <Grid>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Панель управления рестораном"
                                  Style="{StaticResource PageTitleStyle}"
                                  Margin="0,0,0,5"/>
                        <TextBlock x:Name="txtWelcome"
                                  Text="Добро пожаловать в систему управления рестораном!"
                                  Foreground="#636E72"
                                  FontSize="14"/>
                    </StackPanel>

                    <!-- Информация о пользователе (справа вверху) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBlock Text="" Foreground="#636E72" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtUserName"
                                  Text="Загрузка..."
                                  Foreground="#2D3436"
                                  FontSize="14"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"/>
                        <Border x:Name="roleBadge"
                                Background="#FF6B6B" 
                                CornerRadius="12" 
                                Padding="12,6">
                            <TextBlock x:Name="txtUserRole"
                                      Text="Роль" 
                                      Foreground="White" 
                                      FontSize="12" 
                                      FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Область контента -->
            <Grid Grid.Row="1" Margin="25,20,25,25">

                <!-- 🏠 Главный экран (по умолчанию) -->
                <ScrollViewer x:Name="mainContent" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Приветствие -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="БЫСТРАЯ СТАТИСТИКА"
                                          Foreground="#FF6B6B"
                                          FontSize="16"
                                          FontWeight="Bold"
                                          Margin="0,0,0,20"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Карточка 1 -->
                                    <Border Grid.Column="0" Background="#FFF9F9F9" 
                                            CornerRadius="10" Padding="15" Margin="5"
                                            BorderBrush="#FFE8E8E8" BorderThickness="1">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock x:Name="txtStatDishes" Text="42"
                                                      Foreground="#FF6B6B"
                                                      FontSize="28"
                                                      FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Блюд в меню"
                                                      Foreground="#636E72"
                                                      FontSize="12"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Карточка 2 -->
                                    <Border Grid.Column="1" Background="#FFF9F9F9" 
                                            CornerRadius="10" Padding="15" Margin="5"
                                            BorderBrush="#FFE8E8E8" BorderThickness="1">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock x:Name="txtStatOrders" Text="18"
                                                      Foreground="#4ECDC4"
                                                      FontSize="28"
                                                      FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Активных заказов"
                                                      Foreground="#636E72"
                                                      FontSize="12"
                                                      HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Карточка 3 -->
                                    <Border Grid.Column="2" Background="#FFF9F9F9" 
                                            CornerRadius="10" Padding="15" Margin="5"
                                            BorderBrush="#FFE8E8E8" BorderThickness="1">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock x:Name="txtStatTables" Text="24"
                                                      Foreground="#FDCB6E"
                                                      FontSize="28"
                                                      FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Столиков"
                                                      Foreground="#636E72"
                                                      FontSize="12"
                                                      HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Карточка 4 -->
                                    <Border Grid.Column="3" Background="#FFF9F9F9" 
                                            CornerRadius="10" Padding="15" Margin="5"
                                            BorderBrush="#FFE8E8E8" BorderThickness="1">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock x:Name="txtStatClients" Text="156"
                                                      Foreground="#00B894"
                                                      FontSize="28"
                                                      FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Клиентов"
                                                      Foreground="#636E72"
                                                      FontSize="12"
                                                      HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- 📋 Контейнер для справочников (скрыт по умолчанию) -->
                <Border x:Name="directoryContent"
                        Background="#F5F5F5"
                        Visibility="Collapsed">
                    <ContentControl x:Name="directoryContentControl"/>
                </Border>

            </Grid>
        </Grid>
    </Grid>
</Window>