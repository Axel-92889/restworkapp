<Window x:Class="RestaurantWorkApp.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация - Пицца от Куницы"
        Height="533" Width="450"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        FontFamily="Segoe UI">

    <Border Background="White" CornerRadius="20" Effect="{StaticResource CardShadow}" Margin="0,0,0,10">
        <Grid Margin="40,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Кнопка выхода (в правом верхнем углу) -->
            <Button Grid.Row="0" 
                    x:Name="btnExit"
                    Width="32" 
                    Height="32" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top"
                    Click="btnExit_Click"
                    Cursor="Hand"
                    ToolTip="Выйти из приложения"
                    Style="{StaticResource SecondaryButtonStyle}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="#FF6B6B"
                                CornerRadius="16"
                                Width="32"
                                Height="32">
                            <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" 
                                  Fill="White" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF5252"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <StackPanel Grid.Row="0" Margin="0,0,0,30">
                <!-- Заголовок -->
                <Border Background="#FF6B6B" CornerRadius="15" Padding="25,20" Margin="0,0,0,25">
                    <StackPanel>
                        <TextBlock Text="🍕 Пицца от Куницы"
                                  Foreground="White"
                                  FontSize="26"
                                  FontWeight="Bold"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="Панель управления рестораном"
                                  Foreground="#FFE0E0"
                                  FontSize="13"
                                  HorizontalAlignment="Center"
                                  Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Форма входа -->
                <StackPanel Margin="0,0,0,20">
                    <!-- Логин -->
                    <TextBlock Text="Логин"
                              Foreground="#636E72"
                              FontSize="13"
                              FontWeight="SemiBold"
                              Margin="0,0,0,8"/>

                    <Border Background="#F8F9FA" 
                            BorderBrush="#DFE6E9" 
                            BorderThickness="2" 
                            CornerRadius="10"
                            Padding="15,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="txtLogin"
                                    Grid.Column="1"
                                    Height="45"
                                    Background="Transparent"
                                    Foreground="#2D3436"
                                    BorderThickness="0"
                                    FontSize="14"
                                    VerticalContentAlignment="Center"
                                    Text="admin"/>
                        </Grid>
                    </Border>

                    <!-- Пароль -->
                    <TextBlock Text="Пароль"
                              Foreground="#636E72"
                              FontSize="13"
                              FontWeight="SemiBold"
                              Margin="0,20,0,8"/>

                    <Border Background="#F8F9FA" 
                            BorderBrush="#DFE6E9" 
                            BorderThickness="2" 
                            CornerRadius="10"
                            Padding="15,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="txtPassword"
                                        Grid.Column="1"
                                        Height="45"
                                        Background="Transparent"
                                        Foreground="#2D3436"
                                        BorderThickness="0"
                                        FontSize="14"
                                        VerticalContentAlignment="Center"
                                        Password="admin123"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Кнопка входа -->
                <Button x:Name="btnLogin"
                        Height="50"
                        Margin="0,10,0,0"
                        Click="btnLogin_Click"
                        Cursor="Hand"
                        Style="{StaticResource PrimaryButtonStyle}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="ВОЙТИ В СИСТЕМУ" 
                                  FontSize="14" 
                                  FontWeight="Bold"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Статус -->
                <Border x:Name="statusBorder"
                       Background="#FFF5F5F5"
                       BorderBrush="#DFE6E9"
                       BorderThickness="1"
                       Padding="15,12"
                       Margin="0,20,0,0"
                       CornerRadius="10">
                    <TextBlock x:Name="txtStatus"
                              Text="Введите учетные данные для доступа к системе"
                              Foreground="#636E72"
                              FontSize="12"
                              HorizontalAlignment="Center"
                              TextWrapping="Wrap"/>
                </Border>

                <!-- Подсказка -->
            </StackPanel>
        </Grid>
    </Border>
</Window>